# API base URL, including the version prefix. No trailing slash.
# For a same-origin deployment behind a reverse proxy, use a root-relative path instead
# of an absolute URL, e.g. VITE_API_BASE_URL=/api/v1 — this avoids CORS entirely and needs
# no rebuild if the hostname changes later.
VITE_API_BASE_URL=http://localhost:8000/api/v1

# Display name of the application.
VITE_APP_NAME=Lensora
